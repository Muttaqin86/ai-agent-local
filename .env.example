# AI Coding Agent Configuration
# ==============================
# File ini DIBACA (commit ke git) sebagai referensi untuk pengaturan konfigurasi.
# Salin ke file .env di direktori root dan sesuaikan nilai sesuaibutuhan.
# JANGAN menyimpan kredensial rahasia di sini jika akan di-share/git.

# -------------------------------------------------------------------------
# MODEL CONFIGURATION
# -------------------------------------------------------------------------
# Nama model yang digunakan (via Ollama atau provider lain)
AGENT_MODEL=gemma3:4b

# Provider LLM (optional, digunakan jika multi-provider)
AGENT_PROVIDER=ollama

# Hostname atau IP host Ollama
AGENT_HOST=localhost

# Port koneksi Ollama
AGENT_PORT=11434

# Base URL penuh untuk Ollama (opsional, akan dibangun dari host+port jika kosong)
AGENT_BASE_URL=http://localhost:11434

# -------------------------------------------------------------------------
# RUNTIME CONFIGURATION
# -------------------------------------------------------------------------
# Maksimal iterasi loop agent (proteksi against infinite loop)
AGENT_MAX_ITERATIONS=50

# Temperature LLM (0.0 = deterministis, 1.0+ = lebih kreatif)
AGENT_TEMPERATURE=0.2

# Timeout per request (detik)
AGENT_TIMEOUT=120

# -------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -------------------------------------------------------------------------
# Level logging (INFO, DEBUG, WARNING, ERROR, CRITICAL)
AGENT_LOG_LEVEL=INFO

# File log (path relatif ke direktori root project)
AGENT_LOG_FILE=logs/agent.log

# -------------------------------------------------------------------------
# CATATAN PENGGUNA
# -------------------------------------------------------------------------
# Cara penggunaan:

# 1. Salin file ini:
#    cp .env.example .env

# 2. Edit file .env dengan editor favorit:
#    nano .env
#    # atau
#    vim .env

# 3. Atur variabel sesuai kebutuhan:
#    # Ganti model menjadi gemma3:1b untuk lebih ringan
#    AGENT_MODEL=gemma3:1b
#
#    # Aktifkan debug logging
#    AGENT_LOG_LEVEL=DEBUG
#
#    # Gunakan di CI/CD pipeline:
#    AGENT_MAX_ITERATIONS=10 AGENT_TEMPERATURE=0.0 python3 -m agent_core.cli "task"

# 4. Jalankan agent:
#    python3 -m agent_core.cli "tulis fungsi faktorial"

# -------------------------------------------------------------------------
# HIERARCHI PRIORITAS (yang lebih tinggi akan menimpa yang lebih rendah)
# -------------------------------------------------------------------------
# CLI Arguments  >  Environment Variables  >  config/model.yaml  >  code defaults

# Contoh:
#   --model gemma3:1b   (CLI, paling kuat)
#   AGENT_MODEL=gemma3:1b  (Env Var)
#   config/model.yaml model: gemma3:4b  (File config)
#   gemma3:4b (Default code, paling lemah)